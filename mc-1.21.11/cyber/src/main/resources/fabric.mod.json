{
  "schemaVersion": 1,
  "id": "aicoder-client",
  "version": "${version}",
  "name": "AiCoder Client",
  "description": "Cyberpunk GUI theme for Meteor Client.",
  "authors": [
    "AiCoder"
  ],
  "contact": {
    "sources": "https://github.com/xiaojiaxinxiao3-beep/AiCoder-"
  },
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "aicoder.client.AiCoderAddon"
    ]
  },
  "custom": {
    "meteor-client:color": "255,42,109",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
